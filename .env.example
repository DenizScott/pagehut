# Copy to .env.local and fill in to enable GitHub sign-in (see docs/GITHUB-SETUP.md).
# Leave empty to run in local mode only.
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
GITHUB_APP_SLUG=
# At least 32 random characters:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=
# Optional fixed public URL (must match a callback URL of the GitHub App)
PAGEHUT_PUBLIC_URL=
